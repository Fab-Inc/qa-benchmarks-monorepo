# API keys for the providers configured in custom_models.yaml
# Copy this file to .env and fill in the keys for the providers you use.

ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MOONSHOT_API_KEY=
XAI_API_KEY=

# For local development only — set this to the service account email to impersonate.
# Production uses service account credentials directly instead.
GOOGLE_CLOUD_IMPERSONATE_SERVICE_ACCOUNT=

# Only needed if the ai-for-ed-public Azure container stops being public. The
# leaderboard's providermeta.json is read from it anonymously today, so leave blank.
AZURE_SAS_TOKEN=

# Key for Hugging Face API access to push datasets to
# AI-for-Education organization on Hugging Face
HF_TOKEN=
